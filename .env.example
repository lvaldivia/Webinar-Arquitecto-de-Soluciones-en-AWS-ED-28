# Copia este archivo como .env y ajusta los valores.
# docker compose lo lee automáticamente; en la EC2 lo usa scripts/setup-instance.sh.

# Versión que muestra /api/info (útil para ver un despliegue nuevo en vivo)
APP_VERSION=1.0.0

# Tope de segundos que acepta POST /api/stress (si piden más, se recorta a este valor)
STRESS_MAX_SECONDS=300

# Nivel de logs: DEBUG muestra también los health checks del ALB
LOG_LEVEL=INFO
