# Copia este archivo como terraform.tfvars y ajusta el perfil.
# terraform.tfvars está en .gitignore: no se sube al repo.

# Perfil de AWS CLI (aws configure --profile <nombre>). Quita la línea para usar el default.
aws_profile = "default"

# region        = "us-east-1"
# prefix        = "grimorios"
# instance_type = "t3.micro"
# scripts/build-api-ami.sh genera api-ami.auto.tfvars.json desde el backend local.
# El ID de AMI lo escribe automáticamente el constructor; no lo fijes aquí.
# tags = {
#   Curso = "arquitectura-aws"
# }
